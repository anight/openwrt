From: Andrei Nigmatulin <andrei.nigmatulin@gmail.com>
Subject: hostapd: WPS: send the passphrase to Enrollees without a display

hostapd prefers the 64-hex PSK format for Enrollees that do not support
a display, even when a passphrase is configured. Some devices (e.g.
thermostats with Hi-Flying Wi-Fi modules) cannot use a PSK-format Network
Key and fail with a PSK mismatch after a successful WPS run. When a
passphrase is configured, send it instead, also when a PSK file is
configured next to it (where hostapd otherwise sets no network key at
all and hands out the first PSK of its list in hex).


--- a/src/wps/wps_registrar.c	2026-10-18 20:05:07.062490931 +0100
+++ b/src/wps/wps_registrar.c	2026-10-18 20:05:07.073829915 +0100
@@ -1747,7 +1747,13 @@
 		os_memcpy(wps->cred.key, hex, PMK_LEN * 2);
 		wps->cred.key_len = PMK_LEN * 2;
 	} else if (!wps->wps->registrar->force_per_enrollee_psk &&
-		   wps->use_psk_key && wps->wps->psk_set) {
+		   wps->use_psk_key && wps->wps->psk_set &&
+		   !wps->wps->network_key) {
+		/*
+		 * With a passphrase configured, hand out the passphrase even to
+		 * Enrollees without a display: some (e.g. Hi-Flying Wi-Fi
+		 * modules) cannot use a Network Key in 64-hex PSK format.
+		 */
 		wpa_printf(MSG_DEBUG, "WPS: Use PSK format for Network Key");
 		wpa_snprintf_hex(hex, sizeof(hex), wps->wps->psk, PMK_LEN);
 		os_memcpy(wps->cred.key, hex, PMK_LEN * 2);
--- a/src/ap/wps_hostapd.c	2026-10-18 20:19:10.726273472 +0100
+++ b/src/ap/wps_hostapd.c	2026-10-18 20:19:10.743372419 +0100
@@ -1235,9 +1235,13 @@
 		wps->auth_types |= WPS_AUTH_OPEN;
 	}
 
-	if (conf->ssid.wpa_psk_file) {
+	if (conf->ssid.wpa_psk_file && !conf->ssid.wpa_passphrase) {
 		/* Use per-device PSKs */
 	} else if (conf->ssid.wpa_passphrase) {
+		/*
+		 * A passphrase is handed out as is, also next to a PSK file
+		 * (entries marked wps=1 in the file still take precedence)
+		 */
 		wps->network_key = (u8 *) os_strdup(conf->ssid.wpa_passphrase);
 		wps->network_key_len = os_strlen(conf->ssid.wpa_passphrase);
 	} else if (conf->ssid.wpa_psk) {
@@ -1483,9 +1487,13 @@
 	wps->network_key = NULL;
 	wps->network_key_len = 0;
 	wps->psk_set = 0;
-	if (conf->ssid.wpa_psk_file) {
+	if (conf->ssid.wpa_psk_file && !conf->ssid.wpa_passphrase) {
 		/* Use per-device PSKs */
 	} else if (conf->ssid.wpa_passphrase) {
+		/*
+		 * A passphrase is handed out as is, also next to a PSK file
+		 * (entries marked wps=1 in the file still take precedence)
+		 */
 		wps->network_key = (u8 *) os_strdup(conf->ssid.wpa_passphrase);
 		if (!wps->network_key)
 			return;
