 	int wps;
 	u8 psk[PMK_LEN];
+	char passphrase[64]; /* the entry's passphrase, if it was given as one (for WPS) */
 	u8 addr[ETH_ALEN];
 	u8 p2p_dev_addr[ETH_ALEN];
 	int vlan_id;
